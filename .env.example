# ============================================================
# Nanggroe IoT — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ============================================================

# --- Database ---
DATABASE_URL="file:./db/nanggroe-iot.db"

# --- AI / LLM ---
# Z-AI SDK key (for cloud LLM access)
ZAI_API_KEY=""

# --- Telegram Bot (Hermes Agent) ---
TELEGRAM_BOT_TOKEN=""

# --- Serial / Hardware ---
# Default serial port for Arduino/Pixhawk connection
SERIAL_PORT="/dev/ttyUSB0"
SERIAL_BAUD_RATE="115200"

# --- I2C ---
I2C_BUS="1"

# --- SPI ---
SPI_DEVICE="/dev/spidev0.0"

# --- GPS ---
GPS_SERIAL_PORT="/dev/ttyAMA0"
GPS_BAUD_RATE="9600"

# --- Camera ---
CAMERA_DEVICE="/dev/video0"
CAMERA_RESOLUTION="1920x1080"

# --- GSM Module ---
GSM_SERIAL_PORT="/dev/ttyUSB2"
GSM_BAUD_RATE="115200"
GSM_APN="internet"

# --- Solar Panel Monitor ---
SOLAR_I2C_ADDRESS="0x68"

# --- Power / Battery ---
BATTERY_WARN_VOLTAGE="11.1"
BATTERY_CRIT_VOLTAGE="10.5"

# --- Face Tracking ---
FACE_TRACKING_CAMERA="0"
FACE_TRACKING_CONFIDENCE="0.6"

# --- Server ---
PORT="3000"
HOST="0.0.0.0"

# --- MCP Protocol ---
MCP_PORT="8080"

# --- Extension Bridge (WebSocket) ---
EXTENSION_WS_PORT="8081"
